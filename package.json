{
	"author": "Paul Williams",
	"name": "p45",
	"description": "Svelte library for programmatically crafting grid based SVGs.",
	"type": "module",
	"license": "MIT",
	"version": "0.13.0",
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PaulioRandall/p45.git"
	},
	"keywords": [
		"svg",
		"icon",
		"grid",
		"svelte",
		"plunder"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"fmt": "prettier --plugin prettier-plugin-svelte --log-level warn --write .",
		"build": "vite build",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --testPathPattern ./src/",
		"package": "svelte-package -t false",
		"dev": "npm run fmt && vite dev --port 3000",
		"docs": "p24 -g \"dist/*.svelte\"",
		"commit": "npm run fmt && npm run test && npm run build && npm run package && npm run docs && cat ./scripts/ready-to-ship.txt"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "3.2.2",
		"@sveltejs/kit": "2.5.16",
		"@sveltejs/package": "2.3.2",
		"jest": "29.7.0",
		"p24": "0.19.0",
		"prettier": "3.3.2",
		"prettier-plugin-svelte": "3.2.4",
		"vite": "5.3.1"
	},
	"dependencies": {
		"victor": "^1.1.0"
	},
	"peerDependencies": {
		"svelte": "4.x"
	}
}
